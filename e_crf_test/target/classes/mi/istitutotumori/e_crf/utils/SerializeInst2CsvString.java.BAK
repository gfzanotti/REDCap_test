/**
 * Classe con metodi statici per la conversione delle strutture dati
 * - da un arrray di liste dell'instrument.getField ad una stringa con oggetti Json
 * - da un oggetto JsonNode ad un file .csv
 */
public class SerializeInst2CsvString {
	
	private static final Logger dataStructLog = LogManager.getLogger("bl_Logger");
	
	private List<AbstractInstrument> instruments;
	private String filename;
	private List<List<String>> tableCsv;
	private String csv;
	//private List<String> setEliminato = new ArrayList<>();
	private Set<String> setEliminato = new HashSet<>();


	// Colonne richieste da REDCap
	private static final List<String> COLUMNS = Arrays.asList(
			"field_name", "form_name", "section_header", "field_type", "field_label",
			"select_choices_or_calculations", "field_note", "text_validation_type_or_show_slider_number",
			"text_validation_min", "text_validation_max", "identifier", "branching_logic", "required_field",
			"custom_alignment", "question_number", "matrix_group_name", "matrix_ranking", "field_annotation"
			);

	/**
	 * Costruttore che crea l'attributo "instruments" da cui viene deserializzata la stringa dei dati da inviare
	 * @param instruments
	 */
	public SerializeInst2CsvString(List<AbstractInstrument> instruments, String filename) {
		super();
		this.instruments = instruments;
		this.filename = (filename != null) ? filename : null;
		this.tableCsv = fromInstrumentsToCSV(instruments);
		this.csv = wrapperSerializerCsv(instruments, filename);
	}

	/**
	 * Costruttore che crea l'attributo "instruments da cui viene deserializzata la stringa dei dati da inviare
	 * Però prende in ingresso un solo Instrument
	 * @param instrument
	 * NON FUNZIOAN na controlla i parametri del vari metodi
	 */
	/*
	public SerializeInst2CsvString(AbstractInstrument instrument, String filename) {
		super();
		this.instruments = List.of(instrument);
		this.filename = (filename != null) ? filename : null;
		this.tableCsv = fromInstrumentsToCSV(instrument);
		this.csv = wrapperSerializerCsv(instrument, filename);
	}
	*/


	/**
	 * Metodo essenziale per la conversione da instrument.getField.
	 * Fornisce una forma "tabellare" di liste di stringhe con separatore tra le singole stringhe
	 * (formato "csv")
	 * @param data (oggetto Instrument)
	 */
	private List<List<String>> fromFieldToCSV(AbstractInstrument data) {

		List<String> varSetInst = data.getVariableNameSet();     // lista dei nomi delle variabili di tutti i fields di QUESTO INSTRUMENT
		List<List<String>> rows = new ArrayList<>();
		
		dataStructLog.info("Inizio tracciamento Branching Logic BLOCCANTI");
		dataStructLog.info("\t Instrument :  {} ", data.getName());

		for(Field f : data.getFields()) {
			List<String> row = new ArrayList<>();
			// Scrittura CSV, prima faccio controllo su branching logic
			List<String> values = controlBranchingLogic(varSetInst, f, f.getBranchingLogic());
			
			row.add(f.getFieldName());
			row.add(f.getFormName());
			row.add(f.getSectionHeader());
			row.add(f.getFieldType());
			row.add(f.getFieldLabel());
			row.add(f.getSelectChoicesOrCalculations());
			row.add(f.getFieldNote());
			row.add(f.getTextValidationEG());
			row.add(f.getTextValidationMin());
			row.add(f.getTextValidationMax());
			row.add(f.getIdentifier());
			// scelgo cosa mettere in branching logic
			row.add(values.get(0));
			row.add(f.getRequiredField());
			row.add(f.getCustomAlignment());
			row.add(f.getQuestionNumber());
			row.add(f.getMatrixGroupName());
			row.add(f.getMatrixRanking());
			// scelgo cosa mettere in field annotation
			if (values.get(1) == null || values.get(1).isBlank()) {
			    row.add(f.getFieldAnnotation());
			} else {
			    row.add(String.join("  &  ", f.getFieldAnnotation(), values.get(1)));
			}

			


			rows.add(row);
		}

		return rows;
	}

	/**
	 * Wrapper del metodo precedente: public static List<List<String>> fromFieldToCSV(AbstractInstrument data)
	 * per l'<b>esecuzione su un solo oggetto Instrument</b>
	 * @param data (oggetto Instrument)
	 * @param filename o null se voglio solo l'oggetto tipo List<List<String>> csv
	 * 			e non voglio memorizzare il file *.csv
	 */
	//    public static List<List<String>> fromInstrumentToCSV(AbstractInstrument data, String filename) {
	//    	List<List<String>> csv = new ArrayList<>();
	//	    csv.add(COLUMNS);
	//	    csv.addAll(fromFieldToCSV(data));
	//	    Optional.ofNullable(filename).ifPresent(f -> DeserializeInst2Csv.writeFileCsv(csv, filename));
	//
	//	    return csv;
