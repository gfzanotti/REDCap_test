			<!-- Exec Plugin per eseguire il generatore UML MANUALMENTE -->
			<!--  mvn clean compile  ;  2. Poi esegui il generatore UML  mvn
			exec:java -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>

				<executions>
				
					<!-- ESECUZIONE UML_1 -->
					<execution>
						<id>run-uml-1</id>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>utility.Uml_1</mainClass>
						</configuration>
					</execution>

					<!-- ESECUZIONE UML_0 -->
					<execution>
						<id>run-uml-0</id>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>utility.Uml_0</mainClass>
						</configuration>
					</execution>
					
					<!-- ESECUZIONE UML_2 -->
					<execution>
						<id>run-uml-2</id>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>utility.Uml_2</mainClass>
						</configuration>
					</execution>
					
					
				</executions>
			</plugin>
			
			<!-- IMPOSTAZIONE ESECUZIONE  & PMD-->
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-pmd-plugin</artifactId>
			    <version>3.21.0</version>
			
			    <configuration>
			        <failOnViolation>false</failOnViolation>
			        <rulesets>
			            <ruleset>src/main/resources/pmd-ruleset.xml</ruleset>
			        </rulesets>
			        <printFailingErrors>true</printFailingErrors>
			    </configuration>
			
			    <executions>
			        <execution>
			            <phase>verify</phase>
			            <goals>
			                <goal>check</goal>
			            </goals>
			        </execution>
			    </executions>
			</plugin>
			<!-- -->
			
			

		</plugins>

		<!-- Directory di output per le risorse -->
		<resources>
