	//    	return strCsv(obj);
	//    }

	/**
	 * Wrapper del metodo precedente: public static List<List<String>> fromFieldToCSV(AbstractInstrument data)
	 * per l'<b>esecuzione su una lista di oggetti Instruments</b>
	 * @param data (oggetto Instrument)
	 * @param filename o null se voglio solo l'oggetto tipo List<List<String>> csv
	 * 			e non voglio memorizzare il file *.csv
	 */
	private List<List<String>> fromInstrumentsToCSV(List<AbstractInstrument> instruments) {
		List<List<String>> csv = new ArrayList<>();
		csv.add(COLUMNS); // solo una volta

		for (AbstractInstrument inst : instruments) {
			csv.addAll(fromFieldToCSV(inst)); // nessuna duplicazione
		}
		return csv;
	}

	private String wrapperSerializerCsv(List<AbstractInstrument> data, String filename) {
		List<List<String>> obj = fromInstrumentsToCSV(data);
		Optional.ofNullable(filename).ifPresent(f -> SerializeInst2CsvString.writeFileCsv(obj, filename));
		return strCsv(obj);
	}



	// prende la  tabella/array di liste di stringhe e scrive un file .csv
	private static void writeFileCsv(List<List<String>> csv, String filename) {
		// Percorso del file da salvare
		Path filePath = Paths.get(filename);

		// Prendo solo la directory (senza il nome del file)
		Path directory = filePath.getParent();

		try {
			// Crea la directory se non esiste (idempotente)
			Files.createDirectories(directory);
		} catch (IOException e) {
			System.err.println("Errore nella creazione della directory: " + directory);
			e.printStackTrace();
			return; // interrompe se non posso creare la directory
		}

		try (BufferedWriter writer = Files.newBufferedWriter(filePath)) {
			for (List<String> row : csv) {
				//            	List<String> escaped = new ArrayList<>(row.size());
				//            	for (String value : row) {
				//                    escaped.add(escape(value));
				//                }
				//writer.write(String.join("\t", row)); // CREA CSV CON TAB COME SEPARATORE
				writer.write(String.join(",", row));	// CREA CSV CON "," COME SEPARATORE
				writer.newLine();
			}
			System.out.println("✅ File CSV creato: " + filename);
		} catch (IOException e) {
			System.err.println("Errore nella scrittura del file CSV: " + filePath);
			e.printStackTrace();
		}
	}

	/**
	 * Controlla se nella stringa del campo Branching logic ci sono variabili non codificate in
	 * un intero Instrument e qualora le trova toglie la branching logic bloccante per il
	 * caricamento e la salva (accodandola) come valore dell'attributo fieldAnnotation
	 * 
	 * @param varSetInst è un abstract instrument
	 * @param str è il valore del campo branching logic di uno specifico field
	 * @return String da inserire nel valore del rispettivo attributo del metodo fromFieldToCSV
	 * [DA CONTROLLARE la seguente affermazione]
	 * Il metodo restituisce una List<String> di due elementi:
	 * indice 0 → branching logic valida
	 * indice 1 → branching logic da eliminare
	 */
	private List<String> controlBranchingLogic(List<String> varSetInst, Field f, String str) {
		// List<String> varSetInst = varSetInst.getVariableNameSet();     // lista dei nomi delle variabili di tutti i fields di QUESTO INSTRUMENT
		List<String> varSetStr = new ArrayList<>();     // lista vuota in cui metto le variabili della branching logic
		List<String> returnValues = new ArrayList<>();
		Set<String> nonBlockingVariables = Set.of("event-name");


		Pattern pattern = Pattern.compile("\\[(.*?)\\]");  // cerca variabili racchiuse in []
		Matcher matcher = pattern.matcher(str);
		while (matcher.find()) {
			//if (matcher.group(1).equals("event-name")) {continue;}     // ignoro ["event-name"]
			varSetStr.add(matcher.group(1));     // INSERISCO le variabili della branching logic tranne ["event-name"]
		}

		if (varSetStr != null && !varSetStr.isEmpty()) {
			for(String s: varSetStr) {
				// tratto il set di valori consentiti
				 if (nonBlockingVariables.contains(s)) {
					 returnValues.add(0, str);
					 returnValues.add(1, "");
					 continue;
				    }
				// controllo che tra tutti i nomi delle variabili di tutto l'Instrument non ci sia
				// quello presente nella branching logic se TRUE tolgo la branching logic bloccante
				if (!varSetInst.contains(s)) {
					setEliminato.add(s);
					returnValues.add(0, "");
					returnValues.add(1, str);
					dataStructLog.info("\t\t Field :  {}", f.getFieldName());
					dataStructLog.info("\t variabile non presente : {} \n\t\t branching logic :  {} \n", s, str);
					break;
				} else { // se invece la variabile esiste e la branching logic non è bloccante ...
					returnValues.add(0, str);
					returnValues.add(1, "");
					}
			}
		} else {
			returnValues.add(0, "");
			returnValues.add(1, "");
		}		
		return returnValues;
	}

	/**
	 * metodo che serializza un oggetto List<List<String>> (tabella/array di liste di stringhe) in uno String
	 * per l'invio tramite API
	 * @param  List<List<String>> rows
	 * @throws IOException
	 */
	private static String strCsv(List<List<String>> rows) {

		StringBuilder sb = new StringBuilder();

		for (List<String> row : rows) {
			for (int c = 0; c < row.size(); c++) {
				String value = row.get(c);
				if (value == null) {
					value = "";
				}
				
				value = value.replace("\"", "\"\""); // escape delle virgolette
				value = "\"" + value + "\"";         // racchiudi tra virgolette
				/*
				if (value.contains(",") || value.contains("\"") || value.contains("\n") || value.contains("<")) {
					value = value.replace("\"", "\"\""); // escape delle virgolette
					value = "\"" + value + "\"";         // racchiudi tra virgolette
				}
				*/

				sb.append(value);

				if (c < row.size() - 1) {
					sb.append(",");
				}
			}
			sb.append("\n");
		}
		return sb.toString();
	} // end method strCsv()


	// utile per la conversione alla tabella/array di liste di stringhe precedente
	static String escape(String value) {
		if (value == null) {
			return "";
		}
		//value = value.trim();
		if (value.contains(",") || value.contains("|") || value.contains("\n")) {
			// value = "\"" + value.replace("\"", "\"\"") + "\"";
			value = "\"" + value + "\"";

			// value = "\"" + value.replace("\"", "\"\"") + "\"";
			// value = value.replace("\"", "\\\"");

		}
		return value;
	}

	public List<AbstractInstrument> getInstruments() {
		return instruments;
	}

	public String getFilename() {
		return filename;
	}

	public List<List<String>> getTableCsv() {
		return tableCsv;
	}

	public String getCsv() {
		return csv;
	}

	public Set<String> getSetEliminato() {
		return setEliminato;
	}
}
