	<!-- BUILD PLUGINS -->
	<build>
		<plugins>
			<!-- Compiler -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>${java.version}</release>
				</configuration>
			</plugin>

			<!-- Shade plugin per creare jar eseguibile -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>mi.istitutotumori.app.MainApp</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- JavaFX plugin solo per eseguire l'app -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>mi.istitutotumori.app.MainApp</mainClass>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>generate-javadocs</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>javadoc</goal>
						</goals>
						<configuration>
							<!-- Mettiamo esplicitamente il Javadoc in: target/site/apidocs --> 
							<outputDirectory> ${project.build.directory}/site/apidocs </outputDirectory>

							<release>17</release>
							<encoding>UTF-8</encoding>
							
							<!-- INCLUDI CLASSI PACKAGE-PRIVATE E PRIVATE --> 
							<show>private</show>
							<!-- Genera le pagine HTML dei sorgenti .java -->
							<linksource>true</linksource>
							
							<!-- Assicura che vengano analizzati tutti i package sotto mi.istitutotumori --> 
							<subpackages>mi.istitutotumori</subpackages> 
							
							<doctitle> ${project.name} ${project.version} API </doctitle> 
							<windowtitle> ${project.name} API </windowtitle>
							
							<failOnError>false</failOnError>

							<javadocExecutable>${java.home}/bin/javadoc</javadocExecutable>
					
							<!-- ESEMPIO TAG PERSONALIZZATI -->
							<tags>
								<tag>
									<name>apiNote</name>
									<placement>a</placement>
									<head>API Note:</head>
								</tag>
								<tag>
									<name>implSpec</name>
									<placement>a</placement>
									<head>Implementation Requirements:</head>
								</tag>
								<tag>
									<name>implNote</name>
									<placement>a</placement>
									<head>Implementation Note:</head>
								</tag>
							</tags>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Exec Plugin per eseguire il generatore UML in AUTOMATICO -->
			<!--
				<plugin>
