	-->


    <!-- ─────────── CENTER: Tab Pane (vuoto, popolato da MainApp) ─────────── -->
    <center>
        <TabPane fx:id="tabPane" />
    </center>

    <!-- ─────────── BOTTOM: Buttons (optional) ─────────── -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="runButton"   text="Run"         onAction="#onRun" />
                <Button fx:id="themeButton" text="Tema: Light" onAction="#toggleTheme" />
            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </HBox>
    </bottom>

</BorderPane>


